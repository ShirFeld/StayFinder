{
  "name": "@stayfinder/server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --import tsx --watch src/index.ts",
    "start": "node --import tsx src/index.ts",
    "db:migrate": "node --import tsx src/database.ts migrate",
    "db:seed": "node --import tsx src/database.ts seed",
    "db:reset": "node --import tsx src/database.ts reset",
    "test": "node --import tsx --test --test-concurrency=1 test/*.test.ts",
    "test:ci": "node --import tsx scripts/test-ci.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "better-sqlite3": "^11.8.1",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "express-session": "^1.18.1",
    "helmet": "^8.0.0",
    "stripe": "^23.0.0",
    "swagger-ui-express": "^5.0.1",
    "tsx": "^4.23.15"
  }
}
