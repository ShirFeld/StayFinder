# Optional local QA settings. Copy to server/qa.env; keep keys out of Git.
QA_DB_PATH=./data/qa/stayfinder.sqlite
QA_TIMEZONE=Asia/Jerusalem
# Payments are deliberately disabled unless QA-specific keys are supplied.
QA_STRIPE_SECRET_KEY=
QA_STRIPE_WEBHOOK_SECRET=
# A local controlled weather service can be started here; absent service gives the expected unavailable state.
QA_WEATHER_BASE_URL=http://127.0.0.1:3999/weather
QA_WEATHER_TIMEOUT_MS=1000
