{
  "name": "stayfinder",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": "^22.13.0 || >=24"
  },
  "workspaces": [
    "client",
    "server",
    "automation"
  ],
  "scripts": {
    "dev": "concurrently -k -n API,UI \"npm run dev -w server\" \"npm run dev -w client\"",
    "build": "npm run typecheck && npm run build -w client",
    "start": "npm run start -w server",
    "db:migrate": "npm run db:migrate -w server",
    "db:seed": "npm run db:seed -w server",
    "db:reset": "npm run db:reset -w server -- --confirm",
    "test": "npm run test -w server",
    "test:ci": "npm run test:ci -w server",
    "payments:listen": "node --import tsx server/scripts/stripe-listen.ts",
    "qa:dev": "node --import tsx server/scripts/qa.ts dev",
    "qa:api": "node --import tsx server/scripts/qa.ts api",
    "qa:client": "node --import tsx server/scripts/qa.ts client",
    "qa:db:migrate": "node --import tsx server/scripts/qa.ts migrate",
    "qa:db:seed": "node --import tsx server/scripts/qa.ts seed",
    "qa:db:reset": "node --import tsx server/scripts/qa.ts reset --confirm",
    "qa:status": "node --import tsx server/scripts/qa.ts status",
    "test:automation": "npm run test -w automation",
    "test:api": "npm run test:api -w automation",
    "test:ui": "npm run test:ui -w automation",
    "test:sanity": "npm run test:sanity -w automation",
    "test:payments": "npm run test:payments -w automation",
    "test:db": "npm run test:db -w automation",
    "test:report": "npm run report -w automation",
    "test:sanity:ui": "npm run test:sanity:ui -w automation",
    "test:sanity:debug": "npm run test:sanity:debug -w automation",
    "typecheck": "npm run typecheck:config && npm run typecheck --workspaces",
    "typecheck:config": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "npm run lint -- --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "check": "npm run format:check && npm run lint && npm run build"
  },
  "devDependencies": {
    "@eslint-react/eslint-plugin": "^5.28.2",
    "@eslint/js": "^10.0.1",
    "@stripe/cli": "^1.54.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^4.17.25",
    "@types/express-session": "^1.19.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/swagger-ui-express": "^4.1.8",
    "concurrently": "^9.1.2",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-playwright": "^2.12.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "jiti": "^2.7.0",
    "prettier": "3.9.10",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.0"
  }
}
