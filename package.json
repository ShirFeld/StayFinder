{
  "name": "stayfinder",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently -k -n API,UI \"npm run dev -w server\" \"npm run dev -w client\"",
    "build": "npm run build -w client",
    "start": "npm run start -w server",
    "db:migrate": "npm run db:migrate -w server",
    "db:seed": "npm run db:seed -w server",
    "db:reset": "npm run db:reset -w server -- --confirm",
    "test": "npm run test -w server",
    "payments:listen": "node server/scripts/stripe-listen.js",
    "qa:dev": "node server/scripts/qa.js dev",
    "qa:api": "node server/scripts/qa.js api",
    "qa:client": "node server/scripts/qa.js client",
    "qa:db:migrate": "node server/scripts/qa.js migrate",
    "qa:db:seed": "node server/scripts/qa.js seed",
    "qa:db:reset": "node server/scripts/qa.js reset --confirm",
    "qa:status": "node server/scripts/qa.js status"
  },
  "devDependencies": {
    "@stripe/cli": "^1.54.0",
    "concurrently": "^9.1.2"
  }
}
